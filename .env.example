# ==========================================
# MediFinder - Environment Configuration Template
# Copy this file to .env (or configure in your IDE / OS environment)
# DO NOT COMMIT ACTUAL PASSWORDS OR PRODUCTION SECRETS TO GIT
# ==========================================

# ------------------------------------------
# Backend Server Configuration
# ------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------
# Database Configuration (MySQL)
# ------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medicare_db
DB_USERNAME=root
DB_PASSWORD=12345678

# ------------------------------------------
# Security & JWT Configuration
# ------------------------------------------
# Secret key for signing JWT tokens (HMAC-SHA256, minimum 256-bit / 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Token validity in milliseconds (e.g., 86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------
# CORS Allowed Origins
# ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------
# Optional External API Keys (Future MVP phases)
# ------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_placeholder
SMS_GATEWAY_API_KEY=your_sms_gateway_key_placeholder
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password_placeholder

# ------------------------------------------
# Frontend Environment Variables (Vite)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_TITLE=MediFinder - Medicine Discovery & Pharmacy Locator

# Google Maps JavaScript API Key (Frontend locator map)
# Leave blank to use the high-fidelity built-in interactive SVG Vector Map
VITE_GOOGLE_MAPS_API_KEY=